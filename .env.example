# Copy this file to .env and fill in the values below.
#   cp .env.example .env

# Required. Bcrypt hash of the admin login password — generate one with:
#   node src/scripts/hash-admin-password.js "your-password-here"
# Only used to seed the first admin row on a brand-new database; once the
# `admins` table has a row, .env's value is never read again.
ADMIN_PASSWORD_HASH=

# Required for a signed session cookie (admin login). Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Controls how outgoing email is actually sent. Leave this whole
# section blank to run in dev mode — emails are logged to the console
# instead of sent, and email_log rows are written with status
# 'logged_dev_mode'. Two ways to configure real sending — if both are
# filled in, SMTP_HOST wins and the GMAIL_* vars below are ignored.

# Option 1: generic SMTP. Works with any provider — a transactional email
# service (SendGrid, Mailgun, Postmark, Amazon SES, Resend, etc.), a mailbox
# on your own domain, anything that speaks SMTP. This is the option to use
# if you want outgoing mail to appear from a domain you own rather than a
# Gmail address.
SMTP_HOST=
# Defaults to 587 (STARTTLS) if left blank.
SMTP_PORT=
# Optional override — 'true' or 'false'. Defaults to true for port 465,
# false otherwise, which is correct for most providers.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Option 2: Gmail shortcut. A plain Gmail account with an app password
# (not your normal Gmail password — generate one at
# https://myaccount.google.com/apppasswords). Only used if SMTP_HOST above
# is blank. Mail will appear to come from this Gmail address.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional, applies to either option above. Sets the "From" name/address
# recipients see. If left blank, defaults to SMTP_USER (or GMAIL_USER for
# the Gmail shortcut) — set FROM_EMAIL explicitly if you're sending through
# a provider where the account you authenticate with isn't the address you
# want mail to appear from (common with transactional email services).
FROM_NAME=
FROM_EMAIL=

# Optional. Used to build absolute links in outgoing emails (confirm, need-sub,
# etc.) and the calendar feed. Defaults to http://localhost:3000 — set this to
# your real domain/IP once deployed, or links in emails will be unusable.
PUBLIC_SITE_URL=http://localhost:3000

# Optional. Port the app listens on. Defaults to 3000.
PORT=3000

# Optional. Overrides where the SQLite database file lives. Defaults to
# ./data/tennis.db (created automatically on first boot).
SQLITE_PATH=

# Optional. Overrides where `npm run backup` writes backup files. Defaults
# to ./backups (created automatically).
BACKUP_DIR=

# Optional. Set all three of HOST/USER/PATH to enable `npm run backup:offsite`
# (pushes backups/ to another machine over rsync+ssh — see "Get backups off
# the Pi" in README.md). Leave blank to leave off-site push disabled; the
# nightly `npm run backup` still runs and works fine without these.
OFFSITE_SSH_HOST=
OFFSITE_SSH_USER=
OFFSITE_SSH_PATH=
# Optional, defaults to 22.
OFFSITE_SSH_PORT=
# Optional. Path to a private key file, if not using the default
# ~/.ssh/id_* key / an ssh-agent already loaded with one.
OFFSITE_SSH_KEY=

# Optional. Enables the per-session weather forecast widget/email block (see
# "Weather forecast" in CLAUDE.md). Get a free key at
# https://openweathermap.org/api (the free "5 day / 3 hour forecast" plan is
# all this app uses — no paid subscription needed). Leave blank to leave the
# feature fully inert even if an admin turns it on and enters coordinates for
# a session; weather.js's cron pass silently skips any session until this is
# set.
OPENWEATHER_API_KEY=
