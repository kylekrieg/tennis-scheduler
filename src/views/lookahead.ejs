<%- include('partials/header', {title, wideMain: true}) %>
<h1>Next <%= session.lookahead_weeks || 4 %> Weeks</h1>
<%- include('partials/session_picker', {sessions, session}) %>

<% if (rows.length === 0) { %>
  <p class="muted">No upcoming weeks in this window.</p>
<% } %>
<table>
  <thead><tr><th style="white-space:nowrap;">Date</th><% if (multiCourt) { %><th>Court</th><% } %><th>Team A</th><th>Team B</th><th>Ball duty</th></tr></thead>
  <tbody>
    <% rows.forEach(function(r) { %>
      <% var courtNums = [...new Set(r.assignments.map(a => a.court))].sort((x, y) => x - y); if (courtNums.length === 0) courtNums = [1]; %>
      <% courtNums.forEach(function(court, ci) { %>
        <tr class="<%= r.week.needs_attention ? 'flagged' : '' %>">
          <% if (ci === 0) { %><td rowspan="<%= courtNums.length %>" style="white-space:nowrap;">
            <%= r.week.match_date %>
            <% if (session.weather_enabled && r.weather) { %>
              <div class="muted" style="font-size:11px;font-weight:normal;white-space:nowrap;margin-top:2px;">
                <% if (weatherIconUrl(r.weather.icon)) { %><img src="<%= weatherIconUrl(r.weather.icon) %>" width="20" height="20" alt="" style="vertical-align:middle;margin-right:-2px;"><% } %>
                <%= weatherSummaryText(r.weather) %>
              </div>
            <% } %>
          </td><% } %>
          <% if (multiCourt) { %><td>Court <%= court %></td><% } %>
          <% ['A','B'].forEach(function(team) { %>
            <td>
              <% r.assignments.filter(a => a.team === team && a.court === court).forEach(function(a) { %>
                <div style="margin-bottom:4px;">
                  <% if (a.subDepth) { %><span class="muted">&#8627;&nbsp;</span><% } %><%= a.name %><% if (a.is_sub) { %> <span class="muted">(sub)</span><% } %>
                  <% if (a.replacesPlayerName) { %><div class="muted" style="font-size:11px;">subbing for <%= a.replacesPlayerName %></div><% } %>
                  <% if (a.doubleBooked && (a.status === 'scheduled' || a.status === 'confirmed')) { %>
                    <span class="badge double_booked">double booked</span>
                    <div class="muted" style="font-size:11px;">also in <%= sessionPublicLabel(a.doubleBooked) %></div>
                  <% } else { %>
                    <span class="badge <%= a.status %>"><%= a.status.replace('_',' ') %></span>
                  <% } %>
                </div>
              <% }) %>
            </td>
          <% }) %>
          <% if (ci === 0) { %><td rowspan="<%= courtNums.length %>"><%= r.ballDutyName || '—' %></td><% } %>
        </tr>
      <% }) %>
    <% }) %>
  </tbody>
</table>
<% if (rows.some(r => r.assignments.some(a => a.doubleBooked && (a.status === 'scheduled' || a.status === 'confirmed')))) { %>
  <p class="muted" style="margin-top:8px;">"Double booked" means you're scheduled to play in two different sessions on the same date — sort it out ahead of time by reassigning yourself in one of them or finding a sub, rather than the week of.</p>
<% } %>
<%- include('partials/footer') %>
