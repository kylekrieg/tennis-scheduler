<%- include('partials/header', {title, wideMain: true}) %>
<h1><%= player.name %>'s Page</h1>
<p class="muted">Bookmark this page — the URL stays the same and always shows your current schedule across every session you're in.</p>

<%# "My Other Dates" (Kyle, 2026-09-26) — tennis outside this app, added so
    the calendar download + subscribe feed hold everything. Read-only unless
    opened from the emailed edit link (see personalEvents.js). %>
<% const ot = otherDates; const slugOrId = player.slug || player.id; %>
<details id="other-dates" class="card wide" style="margin-bottom:20px;"<%= (ot.editable || ot.linkInvalid) ? ' open' : '' %>>
  <summary style="cursor:pointer;font-weight:600;font-size:calc(17px * var(--text-scale, 1));">
    My Other Dates<% if (ot.events.length) { %> <span class="muted" style="font-weight:normal;">(<%= ot.events.length %> upcoming)</span><% } %>
  </summary>
  <p class="muted" style="margin-top:8px;">Playing somewhere else too — another league, a club match, a pickup game? Add it here and it shows up in your <a href="/calendar">calendar download</a> and subscribed calendar next to your league matches, so everything you play is in one place. This is only for your calendar — it doesn't change your league schedule.</p>

  <% if (ot.notice === 'added') { %><p class="notice">Added. Your subscribed calendar will pick it up the next time it refreshes.</p><% } %>
  <% if (ot.notice === 'deleted') { %><p class="notice">Removed.</p><% } %>
  <% if (ot.error) { %><p class="flag error"><%= ot.error %></p><% } %>
  <% if (ot.linkInvalid) { %><p class="flag error">That edit link has expired or isn't valid. Request a fresh one below.</p><% } %>

  <% if (ot.events.length === 0) { %>
    <p class="muted">No other dates added yet.</p>
  <% } else { %>
    <div class="table-scroll">
    <table class="wide">
      <thead><tr><th style="white-space:nowrap;">Date</th><th>Time</th><th>Where</th><th>Notes</th><% if (ot.editable) { %><th></th><% } %></tr></thead>
      <tbody>
        <% ot.events.forEach(function(ev) { %>
          <tr>
            <td style="white-space:nowrap;"><%= fmtDate(ev.event_date) %></td>
            <td style="white-space:nowrap;"><%= fmtTime(ev.start_time) %> <span class="muted">(<%= ev.duration_minutes %> min)</span></td>
            <td><%= [ev.club, ev.court].filter(Boolean).join(', ') || '—' %></td>
            <td><%= ev.notes || '' %></td>
            <% if (ot.editable) { %>
              <td>
                <form method="POST" action="/me/<%= encodeURIComponent(slugOrId) %>/other-dates/<%= ev.id %>/delete" class="inline" onsubmit="return confirm('Remove this date from your calendar?');">
                  <input type="hidden" name="edit" value="<%= ot.editToken %>">
                  <button type="submit" class="btn small red">Delete</button>
                </form>
              </td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>

  <% if (ot.editable) { %>
    <h3 style="margin-bottom:6px;">Add a date</h3>
    <form method="POST" action="/me/<%= encodeURIComponent(slugOrId) %>/other-dates/add" style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;">
      <input type="hidden" name="edit" value="<%= ot.editToken %>">
      <label>Date<br><input type="date" name="event_date" min="<%= ot.today %>" required></label>
      <label>Start time<br><input type="time" name="start_time" required></label>
      <label>Length (min)<br><input type="number" name="duration_minutes" value="90" min="15" max="600" step="15" style="width:90px;"></label>
      <label>Club / location<br><input type="text" name="club" maxlength="120" placeholder="e.g. Riverside Club"></label>
      <label>Court<br><input type="text" name="court" maxlength="120" placeholder="e.g. Court 3" style="width:110px;"></label>
      <label>Notes<br><input type="text" name="notes" maxlength="120" placeholder="optional"></label>
      <button type="submit" class="btn green">Add</button>
    </form>
    <p class="muted" style="font-size:calc(13px * var(--text-scale, 1));margin-top:8px;">You're editing from your emailed link — bookmark this page if you'll add more later. Don't share this link.</p>
  <% } else { %>
    <form method="POST" action="/me/<%= encodeURIComponent(slugOrId) %>/other-dates/request-link" class="inline">
      <div class="hp-field" aria-hidden="true"><label>Leave blank<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
      <button type="submit" class="btn">Email me a link to add dates</button>
    </form>
    <p class="muted" style="font-size:calc(13px * var(--text-scale, 1));margin-top:8px;">To keep anyone else from changing your calendar, adding or removing dates happens from a link we email to you.</p>
  <% } %>
</details>

<% if (draftSessions.length > 0) { %>
  <% draftSessions.forEach(function(s) { %>
    <p class="notice" style="border-left:4px solid <%= sessionColor(s) %>;">
      <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:<%= sessionColor(s) %>;margin-right:4px;"></span>
      <strong><%= sessionPublicLabel(s) %></strong> hasn't been scheduled yet — blackout dates are open.
      <a href="/blackout?session=<%= s.id %>&player=<%= player.id %>">Enter your blackout dates</a>.
    </p>
  <% }) %>
<% } %>

<% if (sessionCards.length === 0 && draftSessions.length === 0) { %>
  <p class="muted">You're not currently enrolled in any session.</p>
<% } %>

<% sessionCards.forEach(function(card) { %>
  <% if (card.blackoutDates.length > 0) { %>
    <div class="notice" style="border-left:4px solid <%= sessionColor(card.session) %>;margin-bottom:4px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
      <span style="flex:1 1 auto;min-width:0;">
        <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:<%= sessionColor(card.session) %>;margin-right:4px;"></span>
        Blackout date<%= card.blackoutDates.length > 1 ? 's' : '' %> for <strong><%= sessionPublicLabel(card.session) %></strong>:
        <%= card.blackoutDates.map(function(d) { return fmtDate(d); }).join(', ') %>
      </span>
      <%# "Edit dates" (Kyle, 2026-10-02): emails a link to a remove-only
          page — see blackoutEdit.js. Adding dates stays on /blackout, and
          only before the season is scheduled. %>
      <form method="POST" action="/blackout/edit-link" class="inline" style="margin:0;">
        <div class="hp-field" aria-hidden="true"><label>Leave blank<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
        <input type="hidden" name="player_id" value="<%= player.id %>">
        <button type="submit" class="btn small neutral" title="We'll email you a link to remove dates you no longer need">Edit dates</button>
      </form>
    </div>
  <% } %>
  <div class="card wide" style="margin-bottom:20px;border-left:6px solid <%= sessionColor(card.session) %>;">
    <h2 style="margin-top:0;display:flex;align-items:center;gap:8px;">
      <span style="display:inline-block;width:13px;height:13px;border-radius:50%;background:<%= sessionColor(card.session) %>;flex-shrink:0;"></span>
      <%= sessionFullTitle(card.session) %>
    </h2>
    <p class="muted" style="margin-top:-8px;">
      Target: <strong><%= card.stats.target %></strong><% if (card.stats.originalTarget != null && card.stats.originalTarget !== card.stats.target) { %> <span class="muted">(originally <%= card.stats.originalTarget %>)</span><% } %>
      &nbsp;&middot;&nbsp; Scheduled: <strong><%= card.stats.scheduled %></strong>
      &nbsp;&middot;&nbsp; Subbed out: <strong><%= card.stats.subbedOut %></strong>
      &nbsp;&middot;&nbsp; Played: <strong><%= card.stats.played %></strong>
      &nbsp;&middot;&nbsp; Sub bonus games: <strong><%= card.stats.subBonus %></strong>
      &nbsp;&middot;&nbsp; Ball duty: <strong><%= card.stats.ballDuty %></strong>
      <% if (card.gamesWonStats) { %>
        &nbsp;&middot;&nbsp; Games won:
        <% if (card.gamesWonStats.totalGames != null) { %>
          <strong><%= card.gamesWonStats.totalGames %></strong> <span class="muted">(#<%= card.gamesWonStats.gamesRank %> of <%= card.gamesWonStats.gamesRankOf %>)</span>
        <% } else { %>
          <span class="muted">not yet entered</span>
        <% } %>
        &nbsp;&middot;&nbsp; Win %:
        <% if (card.gamesWonStats.winPct != null) { %>
          <strong><%= (card.gamesWonStats.winPct * 100).toFixed(1) %>%</strong> <span class="muted">(#<%= card.gamesWonStats.winRank %> of <%= card.gamesWonStats.winRankOf %>)</span>
        <% } else { %>
          <span class="muted">not yet available</span>
        <% } %>
      <% } %>
    </p>

    <% if (card.upcoming.length === 0) { %>
      <p class="muted">No upcoming matches scheduled for you in this session.</p>
    <% } else { %>
      <div class="table-scroll">
<table class="wide">
        <thead><tr><th style="white-space:nowrap;">Date</th><th>Status</th><th>Ball duty</th><th>Also playing this week</th><th></th></tr></thead>
        <tbody>
          <% card.upcoming.forEach(function(a) { %>
            <tr>
              <td style="white-space:nowrap;">
                <%= fmtDate(a.match_date) %>
              </td>
              <td>
                <% if (a.doubleBooked && (a.status === 'scheduled' || a.status === 'confirmed')) { %>
                  <span class="badge double_booked">double booked</span>
                  <div class="muted" style="font-size:12px;margin-top:4px;">Also in <%= sessionFullTitle(a.doubleBooked) %> this date — resolve ahead of time.</div>
                <% } else { %>
                  <span class="badge <%= a.status %>"><%= a.status.replace('_', ' ') %><%= (a.is_sub && a.status !== 'subbed_out') ? ' (sub)' : '' %></span>
                <% } %>
                <% if (a.is_sub && a.replaces_name) { %><div class="muted" style="font-size:12px;margin-top:4px;">Subbing for <%= a.replaces_name %></div><% } %>
                <% if (a.status === 'subbed_out') { %><div class="muted" style="font-size:12px;margin-top:4px;"><% if (a.replaced_by_name) { %>You found a sub — <%= a.replaced_by_name %> is now playing.<% } else { %>You found a sub for this week.<% } %></div><% } %>
              </td>
              <td><%= card.ballDutyDates.has(a.match_date) ? 'Yes' : '' %></td>
              <td>
                <% if (a.others && a.others.length) { %>
                  <% a.others.forEach(function(o, i) { %>
                    <div style="margin-bottom:2px;"><% if (o.is_sub && o.replaces_name) { %><span class="muted">&#8627;&nbsp;</span><% } %><%= o.name %><%= o.is_sub ? ' (sub)' : '' %> <span class="badge <%= o.status %>" style="font-size:10px;padding:1px 5px;"><%= o.status.replace('_', ' ') %></span><% if (o.is_sub && o.replaces_name) { %><div class="muted" style="font-size:10px;">subbing for <%= o.replaces_name %></div><% } %></div>
                  <% }) %>
                <% } else { %>
                  <span class="muted">—</span>
                <% } %>
              </td>
              <td>
                <% if (card.session.session_type !== 'adhoc' && !a.locked && (a.status === 'scheduled' || a.status === 'confirmed')) { %>
                  <div class="row-actions">
                    <% /* Sub tracking only starts once the season's schedule is locked
                          (Kyle, 2026-09-10) — see subFlow.js's createSubRequest() doc
                          comment. Hiding "Need a sub"/"I found a sub" pre-lock avoids
                          sending a player through the form only to hit a "not open yet"
                          message at the end. "Propose a swap" is a separate feature and
                          isn't gated by this. */ %>
                    <% if (card.session.schedule_locked_at) { %>
                      <form method="post" action="/request-sub/start" style="display:inline;">
                        <input type="hidden" name="assignment_id" value="<%= a.id %>">
                        <button class="btn small red" type="submit">Need a sub</button>
                      </form>
                    <% } %>
                    <a class="btn small neutral" href="/swap?session=<%= card.session.id %>&player=<%= player.id %>&assignment=<%= a.id %>">Propose a swap</a>
                    <% if (card.session.schedule_locked_at) { %>
                      <form method="post" action="/found-sub/start" style="display:inline;">
                        <input type="hidden" name="assignment_id" value="<%= a.id %>">
                        <button class="btn small neutral" type="submit">I found a sub</button>
                      </form>
                    <% } %>
                  </div>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
</div>
    <% } %>

    <div class="actions" style="margin-top:12px;">
      <a class="btn small neutral" href="/schedule?session=<%= card.session.id %>">Full schedule</a>
      <a class="btn small neutral" href="/lookahead?session=<%= card.session.id %>">Next 4 weeks</a>
      <a class="btn small neutral" href="/pdf?session=<%= card.session.id %>">Print Schedule</a>
      <% if (card.session.schedule_locked_at) { %>
        <a class="btn small neutral" href="/request-sub?session=<%= card.session.id %>&player=<%= player.id %>">Request a sub</a>
      <% } %>
      <a class="btn small neutral" href="/swap?session=<%= card.session.id %>&player=<%= player.id %>">Swap a week</a>
      <% if (card.session.games_won_enabled) { %>
        <a class="btn small neutral" href="/scores/<%= player.slug || player.id %>">Enter your scores</a>
        <a class="btn small neutral" href="/leaderboard?session=<%= card.session.id %>">Leaderboard</a>
      <% } %>
    </div>
  </div>
<% }) %>

<h2>Calendar</h2>
<p class="muted">Subscribe once and it stays up to date automatically as re-schedules and subs happen — covers every session above, not just one.</p>
<div class="card">
  <div class="actions">
    <a class="btn green" href="<%= feedUrlWebcal %>">Subscribe</a>
  </div>
  <p class="muted">Or add this URL directly in your calendar app (Google Calendar: Settings → Add calendar → From URL):<br>
    <code><%= feedUrlHttps %></code>
  </p>
</div>

<%- include('partials/footer') %>
