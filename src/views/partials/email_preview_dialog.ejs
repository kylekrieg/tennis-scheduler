<%# Email preview popup shared by the Email Log and Super Log (Kyle, 2026-09-29).
    Any link with class email-preview-link and data-subject/data-to/data-sent opens it. %>
<dialog id="email-preview" style="width:min(720px,95vw);max-height:90vh;padding:0;border:1px solid var(--border);border-radius:8px;">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--bg-soft);">
    <div style="min-width:0;">
      <div id="email-preview-subject" style="font-weight:600;overflow-wrap:anywhere;"></div>
      <div class="muted" style="font-size:0.9em;">To <span id="email-preview-to"></span> · <span id="email-preview-sent"></span></div>
      <div class="muted" style="font-size:0.85em;">Links are disabled in this preview.</div>
    </div>
    <button type="button" class="btn neutral" id="email-preview-close">Close</button>
  </div>
  <iframe id="email-preview-frame" title="Email preview" sandbox style="display:block;width:100%;height:70vh;border:0;background:#fff;"></iframe>
</dialog>
<script>
(function () {
  var dlg = document.getElementById('email-preview');
  var frame = document.getElementById('email-preview-frame');
  if (!dlg || typeof dlg.showModal !== 'function') return; // very old browser: link just opens the body in a new page
  document.querySelectorAll('.email-preview-link').forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault();
      document.getElementById('email-preview-subject').textContent = a.dataset.subject;
      document.getElementById('email-preview-to').textContent = a.dataset.to;
      document.getElementById('email-preview-sent').textContent = a.dataset.sent;
      frame.src = a.getAttribute('href');
      dlg.showModal();
    });
  });
  function close() { dlg.close(); }
  document.getElementById('email-preview-close').addEventListener('click', close);
  dlg.addEventListener('click', function (e) { if (e.target === dlg) close(); }); // click outside to close
  dlg.addEventListener('close', function () { frame.src = 'about:blank'; });
})();
</script>
