<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — Doubles' : 'Doubles' %></title>
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
  <script>
    // Set the theme and text size before first paint so there's no
    // flash of the wrong look. Both are per-player preferences stored in
    // this browser's localStorage — see CLAUDE.md's "Larger text" note.
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        var theme = stored || ((window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) { /* private browsing, etc. — default light */ }
      try {
        var textSize = localStorage.getItem('textSize') || 'normal';
        document.documentElement.setAttribute('data-text-size', textSize);
      } catch (e) { /* private browsing, etc. — default normal */ }
    })();
  </script>
  <script src="/js/theme.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/navmenu.js?v=<%= assetVersion %>" defer></script>
</head>
<body>
<header class="site">
  <a class="brand" href="/schedule"><%= siteTitle %></a>
  <button id="nav-toggle" class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">☰</button>
  <nav id="site-nav">
    <a href="/me">My Page</a>
    <a href="/schedule">Full Schedule</a>
    <a href="/lookahead">Next 4 Weeks</a>
    <a href="/request-sub">Request a Sub</a>
    <a href="/swap">Swap a Week</a>
    <a href="/calendar">Calendar</a>
    <a href="/pdf">Print Schedule</a>
    <a href="/news">News</a>
    <a href="/signup">Sign Up</a>
    <a href="/blackout">Blackout Dates</a>
    <a href="/scores">Enter Scores</a>
    <a href="/scores/history">Score History</a>
    <a href="/leaderboard">Leaderboard</a>
    <a href="/stats">Stats</a>
    <a href="/help">How It Works</a>
    <a href="/preferences">Preferences</a>
    <a href="/admin">Admin</a>
    <button id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">🌙</button>
  </nav>
</header>
<% if (typeof newsBanner !== 'undefined' && newsBanner) { %>
<div class="news-banner <%= newsBanner.style %>" id="news-banner" data-key="<%= newsBanner.key %>" role="region" aria-label="Announcement">
  <a class="news-banner-text" href="/news/<%= newsBanner.id %>"><span><%= newsBanner.text %></span> <span class="news-banner-more">Read more →</span></a>
  <button type="button" class="news-banner-close" aria-label="Dismiss announcement" title="Dismiss">×</button>
</div>
<script>
  // Runs inline (not deferred) so a banner this browser already dismissed
  // never flashes on screen. Dismissal is per browser and keyed to the post's
  // last edit — see news.js activeBanner().
  (function () {
    var el = document.getElementById('news-banner');
    try { if (localStorage.getItem('dismissedNewsBanner') === el.getAttribute('data-key')) { el.remove(); return; } } catch (e) {}
    el.querySelector('.news-banner-close').addEventListener('click', function () {
      try { localStorage.setItem('dismissedNewsBanner', el.getAttribute('data-key')); } catch (e) {}
      el.remove();
    });
  })();
</script>
<% } %>
<main class="<%= typeof wideMain !== 'undefined' && wideMain ? 'wide' : '' %>">
