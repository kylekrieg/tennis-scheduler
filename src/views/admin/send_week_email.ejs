<%- include('../partials/admin_header', {title, flashMsg}) %>
<h1>Send Email to Players</h1>
<p class="muted"><%= sessionFullTitle(session) %> — <%= fmtDate(week.match_date) %></p>

<% if (recipients.length === 0) { %>
  <p class="flag error">Nobody is currently playing this week (nothing scheduled/confirmed<%= session.session_type === 'adhoc' ? '/signed up' : '' %> yet) — there's no one to send this to.</p>
<% } else { %>
  <p class="muted">Goes to everyone below, in one email with all addresses in the To: field — not one email per person.</p>
  <p class="muted"><strong>To (<%= recipients.length %>):</strong> <%= recipients.map(function(p) { return fullName(p); }).join(', ') %></p>
<% } %>

<form method="post" action="/admin/sessions/<%= session.id %>/weeks/<%= week.id %>/send-email" class="card">
  <label for="subject">Subject</label>
  <input type="text" name="subject" id="subject" required>
  <label for="body">Message</label>
  <textarea name="body" id="body" required></textarea>
  <div class="actions">
    <button class="btn green" type="submit" <%= recipients.length === 0 ? 'disabled' : '' %>>Send</button>
    <a class="btn neutral" href="/admin/sessions/<%= session.id %>">Cancel</a>
  </div>
</form>

<%- include('../partials/footer') %>
