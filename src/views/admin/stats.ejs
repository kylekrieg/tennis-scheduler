<%- include('../partials/admin_header', {title, wideMain: true}) %>
<h1>Stats — <%= sessionFullTitle(session) %></h1>

<h2>Games played vs. target</h2>
<p class="muted">Target: games this player wants to play this session. Scheduled: every week they were ever put on a court for — this never changes once a week's been played. Subbed out: how many of those scheduled weeks they ended up not playing themselves. Played: the actual weeks they played (Scheduled minus Subbed out).</p>
<table class="wide">
  <thead><tr><th>Player</th><th>Target</th><th>Scheduled</th><th>Subbed out</th><th>Played</th><th>Sub bonus games</th><th>Ball duty</th></tr></thead>
  <tbody>
    <% stats.forEach(function(s) { %>
      <tr>
        <td><%= fullName(s.player) %></td>
        <td><%= s.target %><% if (s.originalTarget != null && s.originalTarget !== s.target) { %> <span class="muted">(originally <%= s.originalTarget %>)</span><% } %></td>
        <td><%= s.scheduled %></td>
        <td><%= s.subbedOut %></td>
        <td><%= s.played %></td>
        <td><%= s.subBonus %></td>
        <td><%= s.ballDuty %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<% if (subStats.length) { %>
<h2>Subs who played this season</h2>
<p class="muted">Not on this session's own roster — picked up a real game via the broader sub list, a self-arranged sub, or a one-time sub. Target and ball duty don't apply to them, so just their games played are shown.</p>
<table>
  <thead><tr><th>Player</th><th>Games played</th></tr></thead>
  <tbody>
    <% subStats.forEach(function(s) { %>
      <tr>
        <td><%= fullName(s.player) %></td>
        <td><%= s.played %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
<% } %>

<h2>Partner matrix</h2>
<table>
  <thead>
    <tr><th></th><% roster.forEach(function(p) { %><th><%= fullName(p) %></th><% }) %></tr>
  </thead>
  <tbody>
    <% roster.forEach(function(p1) { %>
      <tr>
        <th><%= fullName(p1) %></th>
        <% roster.forEach(function(p2) { %>
          <%
            var count = '—';
            if (p1.id !== p2.id) {
              var key = p1.id < p2.id ? p1.id + '_' + p2.id : p2.id + '_' + p1.id;
              count = partnerCounts.get(key) || 0;
            }
          %>
          <td><%= count %></td>
        <% }) %>
      </tr>
    <% }) %>
  </tbody>
</table>

<% if (leaderboard.length) { %>
<h2>Games-won leaderboard</h2>
<p class="muted">Total games won this season, from scores players entered themselves (or an admin set) on the "Games won" field above. Includes anyone who's scored at least one match, roster or sub.</p>
<table>
  <thead><tr><th>Rank</th><th>Player</th><th>Total games won</th><th>Matches scored</th><th>Avg per match</th></tr></thead>
  <tbody>
    <% leaderboard.forEach(function(row, i) { %>
      <tr>
        <td><%= i + 1 %></td>
        <td><%= fullName(row.player) %></td>
        <td><strong><%= row.totalGames %></strong></td>
        <td><%= row.matchesScored %></td>
        <td><%= row.avgPerMatch.toFixed(1) %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
<% } %>

<% if (winLeaderboard.length) { %>
<h2>Win % leaderboard</h2>
<p class="muted">Ranked by games won ÷ games played instead of a raw total, so attendance alone doesn't decide the ranking. Only counts weeks where both games won and games played were entered — a week scored before games-played tracking started (2026-09-10) won't count here even if it's on the total-games leaderboard above. No minimum-attendance qualification is applied.</p>
<table>
  <thead><tr><th>Rank</th><th>Player</th><th>Win %</th><th>Games won</th><th>Games played</th><th>Weeks scored</th></tr></thead>
  <tbody>
    <% winLeaderboard.forEach(function(row, i) { %>
      <tr>
        <td><%= i + 1 %></td>
        <td><%= fullName(row.player) %></td>
        <td><strong><%= (row.winPct * 100).toFixed(1) %>%</strong></td>
        <td><%= row.gamesWon %></td>
        <td><%= row.gamesPlayed %></td>
        <td><%= row.weeksScored %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
<% } %>

<h2>Sub history</h2>
<p class="muted">Escalated: this request was still open when the session's configured lead time before match arrived, so it was fanned out to the broader sub list — the timestamp here is exactly when that escalation email went out. Not every filled request escalates; a lot get claimed straight from the first invite.</p>
<table>
  <thead><tr><th>Week</th><th>Original player</th><th>Filled by</th><th>Status</th><th>Requested</th><th>Escalated</th></tr></thead>
  <tbody>
    <% subHistory.forEach(function(s) { %>
      <tr>
        <td><%= s.match_date %></td>
        <td><%= s.original_player %></td>
        <td><%= s.filled_by || '—' %></td>
        <td><span class="badge <%= (s.status === 'filled' || s.status === 'resolved_manually') ? 'confirmed' : 'needs_sub' %>"><%= s.status.replace('_',' ') %></span></td>
        <td class="muted" style="white-space:nowrap;"><%= s.requestedDisplay %></td>
        <td class="muted" style="white-space:nowrap;"><%= s.escalatedDisplay || '—' %></td>
      </tr>
    <% }) %>
    <% if (subHistory.length === 0) { %><tr><td colspan="6" class="muted">No sub requests yet.</td></tr><% } %>
  </tbody>
</table>
<%- include('../partials/footer') %>
