<%- include('../partials/admin_header', {title, flashMsg}) %>
<p class="muted"><a href="/admin/news">← All posts</a></p>
<h1><%= post.id ? 'Edit post' : 'New post' %></h1>

<form method="post" action="<%= post.id ? '/admin/news/' + post.id : '/admin/news' %>" class="card wide" id="news-form">
  <label for="title">Title</label>
  <input type="text" name="title" id="title" required maxlength="200" value="<%= post.title %>" placeholder="e.g. New: enter your match scores  ·  End-of-season happy hour!">

  <label for="body">Post</label>
  <div class="news-toolbar">
    <label class="btn small neutral news-upload-btn">📷 Add screenshots / photos
      <input type="file" id="news-image-input" accept="image/png,image/jpeg,image/gif,image/webp" multiple hidden>
    </label>
    <button type="button" class="btn small neutral" id="news-preview-btn">Preview</button>
    <span class="muted" id="news-upload-status" aria-live="polite"></span>
  </div>
  <textarea name="body" id="body" rows="18" class="news-textarea" placeholder="Write your announcement here. You can also paste a screenshot straight into this box."><%= post.body %></textarea>
  <div id="news-preview" class="news-body news-preview" hidden></div>

  <details class="card cheatsheet" style="margin-top:12px;">
    <summary>Formatting cheat sheet</summary>
    <table class="compact">
      <tr><td><code>**bold**</code> / <code>*italic*</code></td><td><strong>bold</strong> / <em>italic</em></td></tr>
      <tr><td><code># Heading</code> / <code>## Smaller heading</code></td><td>section headings</td></tr>
      <tr><td><code>- item</code> or <code>1. item</code></td><td>bulleted / numbered list</td></tr>
      <tr><td><code>[link text](https://example.com)</code></td><td>a link (bare URLs link automatically too)</td></tr>
      <tr><td><code>![Caption text](/news/img/12)</code></td><td>an image on its own line shows full width; the text in the brackets becomes its caption. Uploading or pasting adds these for you.</td></tr>
      <tr><td><code>&gt; quote</code></td><td>an indented call-out</td></tr>
      <tr><td><code>---</code></td><td>a divider line</td></tr>
    </table>
    <p class="muted">A blank line starts a new paragraph. Big images are shrunk to 1600px wide before uploading.</p>
  </details>

  <div class="checkbox-row" style="margin-top:16px;"><input type="checkbox" name="published" id="published" value="1" <%= post.published ? 'checked' : '' %>><label for="published" style="margin:0;">Published — visible on the public News page</label></div>
  <div class="checkbox-row"><input type="checkbox" name="pinned" id="pinned" value="1" <%= post.pinned ? 'checked' : '' %>><label for="pinned" style="margin:0;">Pin to the top of the News page</label></div>

  <h2>Site banner</h2>
  <div class="checkbox-row"><input type="checkbox" name="show_banner" id="show_banner" value="1" <%= post.show_banner ? 'checked' : '' %>><label for="show_banner" style="margin:0;">Show a banner linking to this post across the top of every player page</label></div>
  <div id="banner-fields">
    <label for="banner_text">Banner text <span class="muted">(optional — leave blank to use the title)</span></label>
    <input type="text" name="banner_text" id="banner_text" maxlength="240" value="<%= post.banner_text || '' %>" placeholder="e.g. 🍻 Season-end happy hour Fri Oct 17 at 6 PM — details inside">
    <label for="banner_style">Color</label>
    <select name="banner_style" id="banner_style">
      <% bannerStyles.forEach(function (s) { %><option value="<%= s %>" <%= post.banner_style === s ? 'selected' : '' %>><%= bannerStyleLabels[s] %></option><% }) %>
    </select>
    <label for="banner_until">Stop showing the banner after <span class="muted">(optional, inclusive — the post itself stays on the News page)</span></label>
    <input type="date" name="banner_until" id="banner_until" value="<%= post.banner_until || '' %>" min="<%= post.banner_until && post.banner_until < today ? post.banner_until : today %>">
    <p class="muted">Preview:</p>
    <div class="news-banner <%= post.banner_style || 'info' %>" id="banner-preview" style="border-radius:8px;"><span class="news-banner-text"><span id="banner-preview-text"><%= (post.banner_text || '').trim() || post.title || 'Your banner text' %></span> <span class="news-banner-more">Read more →</span></span><span class="news-banner-close" aria-hidden="true">×</span></div>
  </div>

  <div class="actions">
    <button class="btn green" type="submit">Save</button>
    <% if (post.id && post.published) { %><a class="btn neutral" href="/news/<%= post.id %>" target="_blank">View on site</a><% } %>
    <a class="btn neutral" href="/admin/news">Cancel</a>
  </div>
</form>

<% if (post.id) { %>
<form method="post" action="/admin/news/<%= post.id %>/delete" style="margin-top:24px;" onsubmit="return confirm('Delete this post and its uploaded images? This can\'t be undone.');">
  <button class="btn small red" type="submit">Delete post</button>
</form>
<% } %>
<script src="/js/newsEditor.js?v=<%= assetVersion %>" defer></script>
<%- include('../partials/footer') %>
