<%- include('../partials/admin_header', {title, flashMsg}) %>
<h1>Broader Sub List</h1>
<p class="muted">The whole pool of people willing to sub. Being on this list alone doesn't get anyone emailed, though — each session has its own subset of this list ("Manage subs" on that session's page) that decides who actually hears about <em>that</em> session's unanswered sub requests.</p>

<form method="post" action="/admin/sub-list" class="card">
  <label for="name">Name</label>
  <input type="text" name="name" id="name" required>
  <label for="email">Email</label>
  <input type="email" name="email" id="email" required>
  <label for="slug">URL slug (optional)</label>
  <input type="text" name="slug" id="slug" placeholder="auto-generated from name if left blank">
  <p class="muted" style="font-size:12px;margin-top:2px;">Reserved now, used for their My Page link (<code>/me/&lt;slug&gt;</code>) the moment they claim their first sub. Lowercase letters, numbers, and hyphens only — leave blank to generate one from the name automatically.</p>
  <div class="actions"><button class="btn green" type="submit">Add</button></div>
</form>

<table class="wide">
  <thead><tr><th>Name</th><th>Email</th><th>URL slug</th><th>Assigned to</th><th>Actions</th></tr></thead>
  <tbody>
    <% list.forEach(function(l) { %>
      <% var forSessions = sessionsByListId.get(l.id) || []; %>
      <tr>
        <td>
          <form method="post" action="/admin/sub-list/<%= l.id %>/edit" id="edit-<%= l.id %>">
            <input type="text" name="name" value="<%= l.name %>" style="width:140px;">
          </form>
        </td>
        <td><input type="email" name="email" value="<%= l.email %>" form="edit-<%= l.id %>" style="width:200px;"></td>
        <td>
          <input type="text" name="slug" value="<%= l.slug %>" form="edit-<%= l.id %>" style="width:120px;">
          <div class="muted" style="font-size:11px;">/me/<%= l.slug %></div>
        </td>
        <td>
          <% if (forSessions.length === 0) { %>
            <span class="muted">not assigned to any session</span>
          <% } else { %>
            <% forSessions.forEach(function(s, i) { %><a href="/admin/sessions/<%= s.id %>/subs"><%= sessionFullTitle(s) %></a><%= i < forSessions.length - 1 ? ' · ' : '' %><% }) %>
          <% } %>
        </td>
        <td>
          <button class="btn small neutral" type="submit" form="edit-<%= l.id %>">Save</button>
          <form class="inline" method="post" action="/admin/sub-list/<%= l.id %>/remove"><button class="btn small neutral" type="submit">Remove</button></form>
        </td>
      </tr>
    <% }) %>
    <% if (list.length === 0) { %><tr><td colspan="5" class="muted">Empty.</td></tr><% } %>
  </tbody>
</table>
<p class="muted">The URL slug is reserved the moment someone's added to this list, and reused as-is the first time they claim a sub (rather than generating a fresh one then) — so if two people would otherwise land on the same slug (e.g. two "John S"s), you can resolve it here before either one ever claims anything. Editing it later never changes an existing "My Page" link someone's already been sent — only edit it directly here to fix a real collision.</p>
<%- include('../partials/footer') %>
