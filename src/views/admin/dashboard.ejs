<%- include('../partials/admin_header', {title, flashMsg}) %>
<%
  // Each session's dashboard heading (the large title next to the status
  // badge) is the shared sessionFullTitle() composition — see its doc
  // comment in email.js. Session names are meant to be kept short from here
  // on (see the helper text on session_form.ejs) since this now supplies
  // the rest of the identifying detail directly in the title. As of
  // 2026-08-29 this same helper is also used on the public /schedule,
  // /lookahead pages and the session-picker banner, at Kyle's request, so
  // the admin and public titles can't drift out of sync with each other.
  var sessionTitle = sessionFullTitle;
%>
<h1>Dashboard</h1>
<div class="actions"><a class="btn green" href="/admin/sessions/new">+ New session</a></div>

<details class="card wide cheatsheet" id="cheatsheet-dashboard">
  <summary>Before you set up a new session — order of operations</summary>
  <p class="muted" style="margin-top:0;">Same walkthrough shown on the New Session form, repeated here so it's worth a look before you even click "+ New session" above.</p>
  <p><strong>Regular session</strong></p>
  <ol>
    <li>Fill in the session details, then check off the roster and enter each player's target games (and priority, if they're also enrolled in another overlapping session).</li>
    <li>Make sure everyone you want on the roster is already added on the <a href="/admin/players">Players</a> screen, and anyone willing to sub is in the master <a href="/admin/sub-list">Sub List</a> — add them there first if they're new to the system, then come back to check them off.</li>
    <li>Optional: instead of typing every target by hand, save the session first, then use <strong>Sign-Ups</strong> on its detail page to let players declare full/half/quarter time themselves and apply the results to the roster.</li>
    <li>Save the session, then use <strong>Manage subs</strong> on its detail page to pick which sub-list members apply here.</li>
    <li>Save the roster, then click <strong>Notify roster</strong> on the Blackout Dates page (or enter dates yourself as admin).</li>
    <li>Once blackout dates are in, click <strong>Schedule these players</strong> on the session form.</li>
    <li>Check the session detail page and the <a href="/admin/status">Status page</a> for anything flagged — understaffed weeks, unreachable targets, overlapping-session warnings.</li>
    <li>From there it mostly runs itself — reminders, follow-ups, and escalations fire automatically.</li>
  </ol>
  <p><strong>Ad-hoc session</strong></p>
  <ol>
    <li>Fill in the session details and sign-up email timing.</li>
    <li>Make sure everyone you want to invite is already added on the <a href="/admin/players">Players</a> screen — add them there first if they're new to the system.</li>
    <li>Check off the invite-list roster — no targets or priority needed, everyone checked gets invited every week.</li>
    <li>Save. Invite, reminder, and final-roster emails fire automatically from here on, based on the timing you set.</li>
  </ol>
  <p class="muted" style="margin-bottom:0;">Full walkthrough with more detail: <a href="/admin/guide">Admin Guide</a>.</p>
</details>

<% flags.forEach(function(f) { %>
  <div class="session-card">
    <h3><a href="/admin/sessions/<%= f.session.id %>"><%= sessionTitle(f.session) %></a> <span class="badge scheduled"><%= f.session.status %></span></h3>
    <p class="muted"><%= f.session.start_date %> – <%= f.session.end_date %><% if (f.session.season_id && seasonNames[f.session.season_id]) { %> · Season: <a href="/admin/seasons/<%= f.session.season_id %>"><%= seasonNames[f.session.season_id] %></a><% } %><% if (!f.session.games_won_enabled) { %> · <strong>Stats off</strong><% } %></p>
    <div class="flags">
      <% if (f.conflicts.length) { %><div class="flag error"><%= f.conflicts.length %> scheduling conflict(s) — open the session to resolve.</div><% } %>
      <% if (f.needsAttention > 0) { %><div class="flag error"><%= f.needsAttention %> week(s) need attention — short-staffed or otherwise flagged, open the session to review.</div><% } %>
      <% if (!f.session.reminders_enabled) { %><div class="flag">Automatic reminders are off for this session.</div><% } %>
      <% if (f.unconfirmed > 0) { %><div class="flag"><%= f.unconfirmed %> upcoming assignment(s) not yet confirmed.</div><% } %>
      <% if (f.unfilledSubs > 0) { %><div class="flag"><%= f.unfilledSubs %> unfilled sub request(s).</div><% } %>
      <% if (f.unfilledBallDuty > 0) { %><div class="flag"><%= f.unfilledBallDuty %> upcoming week(s) missing ball duty.</div><% } %>
      <% if (f.staleBallDuty > 0) { %><div class="flag error"><%= f.staleBallDuty %> upcoming week(s) with ball duty assigned to someone not actually playing that week — open the session to reassign.</div><% } %>
      <% if (f.overlapping > 0) { %><div class="flag error"><%= f.overlapping %> player(s) enrolled in another overlapping session — the scheduler won't prevent a double-booking on its own, open the session to check.</div><% } %>
      <% if (f.doubleBooked > 0) { %><div class="flag error"><%= f.doubleBooked %> player(s) actually double-booked into another session on the same date — open the session to fix.</div><% } %>
      <% if (f.staleSwaps > 0) { %><div class="flag"><%= f.staleSwaps %> pending swap request(s) nudged but still unanswered — open the session to check or cancel.</div><% } %>
      <% if (!f.conflicts.length && f.needsAttention === 0 && f.session.reminders_enabled && f.unconfirmed === 0 && f.unfilledSubs === 0 && f.unfilledBallDuty === 0 && f.staleBallDuty === 0 && f.overlapping === 0 && f.doubleBooked === 0 && f.staleSwaps === 0) { %><p class="muted">All clear.</p><% } %>
    </div>
  </div>
<% }) %>
<% if (flags.length === 0) { %><p class="muted">No regular sessions yet.</p><% } %>

<% if (adhocSessions.length > 0) { %>
  <h2 style="margin-top:32px;">Ad-hoc sessions</h2>
  <p class="muted">Pickup games — no targets or blackout dates, courts fill first-come-first-served by email sign-up.</p>
  <% adhocSessions.forEach(function (a) { %>
    <div class="session-card">
      <h3><a href="/admin/sessions/<%= a.session.id %>"><%= sessionTitle(a.session) %></a> <span class="badge scheduled">ad-hoc</span></h3>
      <p class="muted"><% if (a.session.season_id && seasonNames[a.session.season_id]) { %>Season: <a href="/admin/seasons/<%= a.session.season_id %>"><%= seasonNames[a.session.season_id] %></a><% } else { %>No season<% } %><% if (!a.session.games_won_enabled) { %> · <strong>Stats off</strong><% } %></p>
      <% if (a.weekSummaries.length === 0) { %>
        <p class="muted">No upcoming match weeks.</p>
      <% } else { %>
        <% a.weekSummaries.forEach(function (ws) { %>
          <div class="flags">
            <% if (ws.finalized) { %>
              <div class="flag">✓ <%= fmtDate(ws.week.match_date) %> &mdash; finalized</div>
            <% } else if (ws.courts > 0 || ws.waiting > 0) { %>
              <div class="flag"><%= fmtDate(ws.week.match_date) %> &mdash; <%= ws.courts %> court(s) filled<% if (ws.waiting > 0) { %>, <%= ws.waiting %> waiting for a full court<% } %></div>
            <% } else { %>
              <div class="flag"><%= fmtDate(ws.week.match_date) %> &mdash; no sign-ups yet</div>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </div>
  <% }) %>
<% } %>

<% if (archivedSessions.length > 0) { %>
  <h2 style="margin-top:32px;">Archived sessions</h2>
  <p class="muted">Hidden from the list above and from players — nothing here was deleted.</p>
  <% archivedSessions.forEach(function(s) { %>
    <div class="session-card" style="opacity:0.75;">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
        <div>
          <a href="/admin/sessions/<%= s.id %>"><%= sessionTitle(s) %></a> <span class="badge scheduled"><%= s.status %></span>
          <p class="muted" style="margin:4px 0 0;"><%= s.start_date %> – <%= s.end_date %><% if (s.season_id && seasonNames[s.season_id]) { %> · Season: <a href="/admin/seasons/<%= s.season_id %>"><%= seasonNames[s.season_id] %></a><% } %></p>
        </div>
        <form method="post" action="/admin/sessions/<%= s.id %>/unarchive">
          <button class="btn small neutral" type="submit">Unarchive</button>
        </form>
      </div>
    </div>
  <% }) %>
<% } %>
<%- include('../partials/footer') %>
