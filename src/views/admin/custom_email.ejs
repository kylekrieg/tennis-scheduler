<%- include('../partials/admin_header', {title, flashMsg, wideMain}) %>
<h1>Send Custom Email</h1>
<form method="post" action="/admin/email" class="card">
  <label>Send to</label>
  <div class="checkbox-row">
    <input type="radio" name="recipient_type" value="player" id="type_player" checked>
    <label for="type_player" style="margin:0;font-weight:400;">One player</label>
  </div>
  <div class="checkbox-row">
    <input type="radio" name="recipient_type" value="session" id="type_session">
    <label for="type_session" style="margin:0;font-weight:400;">Whole session roster</label>
  </div>
  <div class="checkbox-row">
    <input type="radio" name="recipient_type" value="all_players" id="type_all_players">
    <label for="type_all_players" style="margin:0;font-weight:400;">All players</label>
  </div>
  <div class="checkbox-row">
    <input type="radio" name="recipient_type" value="all_players_subs" id="type_all_players_subs">
    <label for="type_all_players_subs" style="margin:0;font-weight:400;">All players + broader sub list</label>
  </div>
  <div class="checkbox-row">
    <input type="radio" name="recipient_type" value="week" id="type_week">
    <label for="type_week" style="margin:0;font-weight:400;">This week's players (one session)</label>
  </div>
  <div class="checkbox-row">
    <input type="radio" name="recipient_type" value="template_test" id="type_template_test">
    <label for="type_template_test" style="margin:0;font-weight:400;">Test a template</label>
  </div>

  <div id="player-picker">
    <label for="player_id">Player</label>
    <select name="player_id" id="player_id">
      <% players.forEach(function(p) { %><option value="<%= p.id %>"><%= fullName(p) %> (<%= p.email %>)</option><% }) %>
    </select>
  </div>

  <div id="session-picker" style="display:none;">
    <label for="session_id">Session</label>
    <select name="session_id" id="session_id">
      <% sessions.forEach(function(s) { %><option value="<%= s.id %>"><%= sessionFullTitle(s) %><%= s.archived_at ? ' (archived)' : '' %></option><% }) %>
    </select>
    <p class="muted" style="margin-top:4px;">Goes to every active player currently on this session's roster — the same list "Notify roster" or ad-hoc invites would use.</p>
  </div>

  <div id="all-players-picker" style="display:none;">
    <p class="muted" style="margin-top:4px;">One email per person (not one email with everyone in the To: field) to all <strong><%= players.length %> active player(s)</strong>:</p>
    <p class="muted" style="margin-top:4px;"><%= players.map(fullName).join(', ') || '— no active players —' %></p>
  </div>

  <div id="all-players-subs-picker" style="display:none;">
    <p class="muted" style="margin-top:4px;">One email per person (not one email with everyone in the To: field) to all <strong><%= players.length %> active player(s)</strong> plus everyone on the <strong>broader sub list (<%= broaderSubList.length %>)</strong>:</p>
    <p class="muted" style="margin-top:4px;"><strong>Players:</strong> <%= players.map(fullName).join(', ') || '— no active players —' %></p>
    <p class="muted" style="margin-top:4px;"><strong>Broader sub list:</strong> <%= broaderSubList.map(fullName).join(', ') || '— empty —' %></p>
  </div>

  <div id="week-picker" style="display:none;">
    <label for="week_session_id">Session</label>
    <select name="week_session_id" id="week_session_id">
      <% sessions.forEach(function(s) { %><option value="<%= s.id %>"><%= sessionFullTitle(s) %><%= s.archived_at ? ' (archived)' : '' %></option><% }) %>
    </select>
    <p class="muted" style="margin-top:4px;">One email, with everyone in the To: field together — not one email per person. Goes to whoever is currently <strong>scheduled or confirmed</strong> for this session's next upcoming match (a "needs a sub" slot or one already subbed out is skipped, since that's not who's actually playing). If this week's match has already happened, it automatically uses the next upcoming one instead.</p>
  </div>

  <div id="template-picker" style="display:none;">
    <label for="template_key">Template</label>
    <select name="template_key" id="template_key">
      <% templates.forEach(function(t) { %><option value="<%= t.key %>"><%= t.label %></option><% }) %>
    </select>
    <label for="test_player_id">Send test to</label>
    <select name="test_player_id" id="test_player_id">
      <% players.forEach(function(p) { %><option value="<%= p.id %>"><%= fullName(p) %> (<%= p.email %>)</option><% }) %>
    </select>
    <p class="muted" style="margin-top:4px;">Sends the real template, built from this player's own current schedule where relevant, so you can confirm it renders and delivers correctly. Subject line gets a "[TEST]" prefix and it's logged under its own category — a real automatic reminder/follow-up/escalation for this player can never be skipped because of it. Any Confirm/Need-a-sub/Claim/Accept link in the email is inert (clicking it does nothing) — this is for checking the email itself, not testing the click-through flow.</p>
  </div>

  <div id="subject-body-fields">
    <label for="subject">Subject</label>
    <input type="text" name="subject" id="subject" required>
    <label for="body">Message</label>
    <textarea name="body" id="body" required></textarea>
  </div>
  <div class="actions"><button class="btn green" type="submit">Send</button></div>
</form>

<h2 id="template-previews">Email templates — preview</h2>
<details class="card wide"<%= openPreviews ? ' open' : '' %>>
  <summary style="cursor:pointer;font-weight:600;">Show what every automatic email looks like (<%= previews.length %> templates)</summary>
  <p class="muted" style="margin-top:8px;">Each template is built from a sample player's own current schedule, the same way "Test a template" above does it, but <strong>nothing is sent</strong> and nothing goes in the Email Log. Links in a preview don't work. Click <strong>Preview</strong> to see the full email. When and who come from the <a href="/admin/guide#email-map">email map</a>.</p>
  <form method="get" action="/admin/email#template-previews" style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;margin-bottom:12px;">
    <label style="margin:0;">Sample player<br>
      <select name="preview_player" onchange="this.form.submit()">
        <% players.forEach(function(p) { %><option value="<%= p.id %>" <%= p.id === previewPlayerId ? 'selected' : '' %>><%= fullName(p) %></option><% }) %>
      </select>
    </label>
    <noscript><button class="btn small neutral" type="submit">Show</button></noscript>
  </form>
  <div class="table-scroll">
  <table class="wide">
    <thead><tr><th>Template</th><th>Subject</th><th>When it goes out</th><th>Who gets it</th><th></th></tr></thead>
    <tbody>
      <% previews.forEach(function(p) { %>
        <% if (p.error || !p.emails.length) { %>
          <tr><td><%= p.label %></td><td colspan="4" class="muted"><%= p.error || 'This template produced no email for this player.' %></td></tr>
        <% } else { p.emails.forEach(function(e, i) { %>
          <tr>
            <td><%= p.label %><% if (p.emails.length > 1) { %> <span class="muted">(<%= i + 1 %> of <%= p.emails.length %>)</span><% } %></td>
            <td style="overflow-wrap:anywhere;"><%= e.subject %></td>
            <td class="muted" style="font-size:calc(13px * var(--text-scale, 1));"><% if (e.map) { %><strong><%= e.map.flow %>:</strong> <%= e.map.when %><% } %></td>
            <td class="muted" style="font-size:calc(13px * var(--text-scale, 1));"><%= e.map ? e.map.to : '' %></td>
            <td><a class="btn small neutral email-preview-link" href="/admin/email/preview/<%= encodeURIComponent(p.key) %>?player=<%= previewPlayerId %>&i=<%= i %>" target="_blank" rel="noopener" data-subject="<%= e.subject %>" data-to="<%= e.to %>" data-sent="sample, not sent">Preview</a></td>
          </tr>
        <% }) } %>
      <% }) %>
    </tbody>
  </table>
  </div>
</details>
<%- include('../partials/email_preview_dialog') %>

<script>
  (function () {
    var playerPicker = document.getElementById('player-picker');
    var sessionPicker = document.getElementById('session-picker');
    var allPlayersPicker = document.getElementById('all-players-picker');
    var allPlayersSubsPicker = document.getElementById('all-players-subs-picker');
    var weekPicker = document.getElementById('week-picker');
    var templatePicker = document.getElementById('template-picker');
    var subjectBody = document.getElementById('subject-body-fields');
    var subject = document.getElementById('subject');
    var body = document.getElementById('body');
    document.querySelectorAll('input[name="recipient_type"]').forEach(function (r) {
      r.addEventListener('change', function () {
        var toPlayer = this.value === 'player';
        var toSession = this.value === 'session';
        var toAllPlayers = this.value === 'all_players';
        var toAllPlayersSubs = this.value === 'all_players_subs';
        var toWeek = this.value === 'week';
        var toTemplate = this.value === 'template_test';
        playerPicker.style.display = toPlayer ? '' : 'none';
        sessionPicker.style.display = toSession ? '' : 'none';
        allPlayersPicker.style.display = toAllPlayers ? '' : 'none';
        allPlayersSubsPicker.style.display = toAllPlayersSubs ? '' : 'none';
        weekPicker.style.display = toWeek ? '' : 'none';
        templatePicker.style.display = toTemplate ? '' : 'none';
        subjectBody.style.display = toTemplate ? 'none' : '';
        subject.required = !toTemplate;
        body.required = !toTemplate;
      });
    });
  })();
</script>
<%- include('../partials/footer') %>
