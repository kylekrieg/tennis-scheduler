<%- include('../partials/admin_header', {title, flashMsg}) %>
<h1>Master Leaderboard</h1>
<p class="muted">Stats live at three levels. The <strong>session</strong> board shows one session. The <strong>season</strong> board combines the sessions in one <a href="/admin/seasons">season</a>. The <strong>master</strong> board combines <em>every</em> session and every player, and keeps counting until you reset it here. Session and season boards are never affected by anything on this page. A session with <strong>Stats off</strong> never feeds the season or master boards.</p>

<div class="card wide">
  <h2 style="margin-top:0;">Current master period</h2>
  <p>Counting matches dated <strong><%= baseline ? baseline + ' and later' : 'from the very beginning (never reset)' %></strong> &mdash; <%= scoredRows %> scored player-match(es) so far.</p>
  <% if (top.length) { %>
    <p class="muted" style="margin-bottom:4px;">Top of the board right now (total games won):</p>
    <ol style="margin-top:0;">
      <% top.forEach(function (r) { %><li><%= fullName(r.player) %> &mdash; <%= r.totalGames %> games in <%= r.matchesScored %> match(es)</li><% }) %>
    </ol>
  <% } else { %>
    <p class="muted">No scores counted in this period yet.</p>
  <% } %>
  <p><a href="/leaderboard?view=master">View the public master board &amp; graphs</a></p>
</div>

<form method="post" action="/admin/master-stats/settings" class="card">
  <h2 style="margin-top:0;">Settings</h2>
  <div class="checkbox-row">
    <input type="checkbox" name="master_stats_visible" id="master_stats_visible" value="1" <%= settings.visible ? 'checked' : '' %>>
    <label for="master_stats_visible" style="margin:0;font-weight:400;">Show the master leaderboard (and past master periods) to players</label>
  </div>
  <label for="min_matches_for_win_pct">Win % board — minimum matches to be ranked</label>
  <input type="number" name="min_matches_for_win_pct" id="min_matches_for_win_pct" value="<%= settings.minMatches %>" min="0" max="100">
  <p class="muted">Players with fewer scored matches than this show in the "still building a sample" list on the master board instead of the ranked table.</p>
  <div class="actions"><button class="btn green" type="submit">Save settings</button></div>
</form>

<form method="post" action="/admin/master-stats/reset" class="card" style="border-color:var(--red);">
  <h2 style="margin-top:0;color:var(--red);">Reset the master leaderboard</h2>
  <p><strong>What this does:</strong> starting today (<%= today %>) the master board counts only matches dated <%= today %> or later, so everyone starts from zero on it. The standings as they are right now are saved in the list below and stay viewable as a past period.</p>
  <p><strong>What this does <em>not</em> do:</strong> no score is deleted, and no session or season board changes. You can undo the most recent reset below.</p>
  <p><strong>Players will notice:</strong> the public master board will look empty until new scores come in.</p>
  <label for="confirm">Type <code>RESET</code> in capital letters to confirm</label>
  <input type="text" name="confirm" id="confirm" autocomplete="off" placeholder="RESET" required>
  <div class="actions"><button class="btn red" type="submit">Reset master leaderboard</button></div>
</form>

<h2>Reset history</h2>
<% if (resets.length === 0) { %>
  <p class="muted">The master leaderboard has never been reset.</p>
<% } else { %>
  <table class="wide">
    <thead><tr><th>Reset date</th><th>Saved as</th><th>Done by</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% var latestActive = resets.find(function (r) { return !r.undone_at; }); %>
      <% resets.forEach(function (r) { %>
        <tr>
          <td><%= r.reset_date %></td>
          <td><%= r.label %></td>
          <td class="muted"><%= r.created_by || '—' %> · <%= r.created_at %></td>
          <td><%= r.undone_at ? 'Undone ' + r.undone_at : 'In effect' %></td>
          <td><% if (!r.undone_at) { %><a href="/leaderboard?view=master:<%= r.id %>">View that period's board</a><% } %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% if (latestActive) { %>
    <form method="post" action="/admin/master-stats/undo" class="card" style="margin-top:16px;">
      <p>Made a mistake? Undoing the most recent reset (<%= latestActive.reset_date %>) puts the master board back to counting from the previous baseline. No scores are touched.</p>
      <label for="undo-confirm">Type <code>UNDO</code> in capital letters to confirm</label>
      <input type="text" name="confirm" id="undo-confirm" autocomplete="off" placeholder="UNDO" required>
      <div class="actions"><button class="btn neutral" type="submit">Undo last reset</button></div>
    </form>
  <% } %>
<% } %>
<%- include('../partials/footer') %>
