<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Login</title>
  <link rel="stylesheet" href="/css/style.css">
  <script>
    // Respect whatever theme the rest of the site is using, so the login
    // page doesn't jar with a light flash before the admin's even in.
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        var theme = stored || ((window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) { /* private browsing, etc. — default light */ }
    })();
  </script>
</head>
<body>
<main>
  <div class="card" style="margin: 60px auto;">
    <h1>Admin Login</h1>
    <% if (error) { %><p class="flag error"><%= error %></p><% } %>
    <form method="post" action="/admin/login">
      <label for="password">Password</label>
      <input type="password" name="password" id="password" autofocus>
      <div class="actions"><button class="btn green" type="submit">Log in</button></div>
    </form>
  </div>
</main>
</body>
</html>
