<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Login</title>
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
  <script>
    // Respect whatever theme and text size the rest of the site is using,
    // so the login page doesn't jar with a normal-size light flash before
    // the admin's even in. No control here (no nav on this page) — just
    // honors whatever was already picked elsewhere on the site.
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        var theme = stored || ((window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) { /* private browsing, etc. — default light */ }
      try {
        var textSize = localStorage.getItem('textSize') || 'normal';
        document.documentElement.setAttribute('data-text-size', textSize);
      } catch (e) { /* private browsing, etc. — default normal */ }
    })();
  </script>
</head>
<body>
<main>
  <div class="card" style="margin: 60px auto;">
    <h1>Admin Login</h1>
    <% if (error) { %><p class="flag error"><%= error %></p><% } %>
    <form method="post" action="/admin/login">
      <label for="username">Username</label>
      <input type="text" name="username" id="username" autocomplete="username" autofocus>
      <label for="password">Password</label>
      <input type="password" name="password" id="password" autocomplete="current-password">
      <div class="actions"><button class="btn green" type="submit">Log in</button></div>
    </form>
  </div>
</main>
</body>
</html>
