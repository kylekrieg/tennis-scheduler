<%- include('../partials/admin_header', {title, flashMsg, wideMain: true}) %>
<h1><%= session.name %> <span class="badge scheduled"><%= session.status %></span><% if (session.archived_at) { %> <span class="badge subbed_out">archived</span><% } %><% if (!session.reminders_enabled) { %> <span class="badge needs_sub">automatic reminders off</span><% } %><% if (session.schedule_locked_at) { %> <span class="badge confirmed">schedule locked</span><% } %></h1>
<p class="muted"><%= session.start_date %> – <%= session.end_date %> · <%= ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][session.match_day_of_week] %> <%= fmtTime(session.match_time) %> · reminders <%= session.reminder_days_before %> day(s) before at <%= fmtTime(session.reminder_time) %><% if (session.schedule_locked_at) { %> · schedule locked <%= session.schedule_locked_at %><% } %></p>

<div class="actions">
  <a class="btn neutral" href="/admin/sessions/<%= session.id %>/edit">Edit session &amp; roster</a>
  <a class="btn neutral" href="/admin/sessions/<%= session.id %>/blackouts">Manage blackout dates</a>
  <a class="btn neutral" href="/admin/sessions/<%= session.id %>/subs">Manage subs</a>
  <a class="btn neutral" href="/admin/sessions/<%= session.id %>/stats">Stats</a>
  <% if (session.schedule_locked_at) { %>
    <form class="inline" method="post" action="/admin/sessions/<%= session.id %>/unlock-schedule">
      <button class="btn neutral" type="submit">Unlock schedule</button>
    </form>
  <% } else { %>
    <form class="inline" method="post" action="/admin/sessions/<%= session.id %>/lock-schedule">
      <button class="btn neutral" type="submit">Lock this schedule</button>
    </form>
  <% } %>
  <% if (session.archived_at) { %>
    <form class="inline" method="post" action="/admin/sessions/<%= session.id %>/unarchive">
      <button class="btn neutral" type="submit">Unarchive</button>
    </form>
  <% } else { %>
    <form class="inline" method="post" action="/admin/sessions/<%= session.id %>/archive">
      <button class="btn neutral" type="submit">Archive session</button>
    </form>
  <% } %>
</div>
<p class="muted" style="margin-top:8px;">Need to (re)generate the schedule? That's on <a href="/admin/sessions/<%= session.id %>/edit">Edit session &amp; roster</a> — kept off this page on purpose so it's not a click away from the buttons you'll use every week.</p>

<% if (conflicts.length) { %>
  <h2>Scheduling conflicts</h2>
  <% conflicts.forEach(function(c) { %>
    <div class="flag error"><strong><%= c.type %>:</strong> <%= c.detail %></div>
  <% }) %>
<% } %>

<% if (overlapConflicts.length) { %>
  <h2>Overlapping session enrollment</h2>
  <p class="muted">These players are also enrolled in another session that meets the same day of week with overlapping dates. This is advisory only — the scheduler doesn't auto-exclude anyone based on it, so nothing stops them from actually being scheduled in both. Setting a <strong>priority</strong> for each on the <a href="/admin/sessions/<%= session.id %>/edit">Edit session</a> roster just records who should probably yield if it turns into a real conflict — it's a note for whoever fixes it by hand, not an automatic rule. Check "Double-booked" below (or the player's own schedule) once both sessions are actually generated. This list stays up for the whole season regardless of whether the shared dates have passed — it's about ongoing enrollment risk, not a single incident.</p>
  <div class="card wide">
    <table>
      <thead><tr><th>Player</th><th>Also enrolled in</th><th>Priority</th></tr></thead>
      <tbody>
        <% overlapConflicts.forEach(function(c) { %>
          <% var other = c.sessionA.id === session.id ? c.sessionB : c.sessionA; %>
          <% var thisPriority = c.sessionA.id === session.id ? c.priorityA : c.priorityB; %>
          <% var otherPriority = c.sessionA.id === session.id ? c.priorityB : c.priorityA; %>
          <% var thisWins = (c.resolution === 'a_wins' && c.sessionA.id === session.id) || (c.resolution === 'b_wins' && c.sessionB.id === session.id); %>
          <tr>
            <td><%= c.player.name %></td>
            <td><a href="/admin/sessions/<%= other.id %>"><%= other.name %></a> <span class="muted">(<%= ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][other.match_day_of_week] %> <%= fmtTime(other.match_time) %>, <%= other.start_date %> – <%= other.end_date %>)</span></td>
            <td class="muted">
              here: <%= thisPriority != null ? thisPriority : 'not set' %>, there: <%= otherPriority != null ? otherPriority : 'not set' %> —
              <% if (c.resolution === 'unresolved') { %>no priority set
              <% } else if (c.resolution === 'tied') { %>tied
              <% } else if (thisWins) { %>this session higher
              <% } else { %><%= other.name %> higher<% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (doubleBookingRows.length) { %>
  <h2>Double-booked</h2>
  <p class="muted">These players are actually assigned to play in two different sessions on the same date — not a risk, a confirmed conflict. Fix by reassigning one of the two slots below. Drops off this list automatically once a date is played and locked.</p>
  <div class="card wide">
    <table>
      <thead><tr><th>Player</th><th>Dates</th><th>Also double-booked in</th></tr></thead>
      <tbody>
        <% doubleBookingRows.forEach(function(row) { %>
          <tr>
            <td><%= row.playerName %></td>
            <td><%= row.dates.map(fmtDate).join(', ') %></td>
            <td><a href="/admin/sessions/<%= row.other.id %>"><%= row.other.name %></a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="muted" style="margin-top:12px;margin-bottom:6px;">
      Each button below covers <strong>every</strong> double-booked player between this session and that one, not just a single row above.
    </p>
    <div class="actions">
      <% distinctOtherSessions.forEach(function(other) { %>
        <a class="btn neutral" href="/admin/sessions/<%= session.id %>/resolve-conflicts?with=<%= other.id %>">Resolve conflicts with <%= other.name %>&hellip;</a>
      <% }) %>
    </div>
  </div>
<% } %>

<h2>Weeks</h2>
<% weekRows.forEach(function(r) { %>
  <div class="session-card <%= r.week.needs_attention ? 'flagged' : '' %>" style="padding:12px 16px;margin-top:10px;">
    <div style="display:flex;align-items:center;flex-wrap:wrap;gap:12px;justify-content:space-between;">
      <div>
        <strong><%= r.week.match_date %></strong>
        <% if (r.week.locked) { %><span class="muted">locked</span><% } %>
        <% if (r.week.needs_attention) { %><span class="muted">⚠ <%= r.week.notes %></span><% } %>
        <% if (r.openSubRequest) { %>
          <span class="badge needs_sub">sub <%= r.openSubRequest.status %> — <%= r.openSubRequest.playerName %></span>
          <% if (!r.week.locked) { %>
            <form class="inline" method="post" action="/admin/sessions/<%= session.id %>/weeks/<%= r.week.id %>/clear-sub-request" style="display:inline;">
              <button class="btn small neutral" type="submit">Clear sub request</button>
            </form>
          <% } %>
        <% } %>
        <% if (r.openSwapRequest) { %>
          <span class="badge needs_sub">swap pending<%= r.openSwapRequest.nudged_at ? ' (nudged)' : '' %></span>
          <% if (!r.week.locked) { %>
            <form class="inline" method="post" action="/admin/sessions/<%= session.id %>/weeks/<%= r.week.id %>/cancel-swap" style="display:inline;">
              <button class="btn small neutral" type="submit">Cancel swap request</button>
            </form>
          <% } %>
        <% } %>
      </div>
      <div style="display:flex;align-items:center;flex-wrap:wrap;gap:16px;">
        <div style="display:flex;align-items:center;gap:6px;">
          <span class="muted">Ball duty:</span>
          <% if (r.week.locked) { %>
            <%= r.ballDutyName || '—' %>
          <% } else if (r.assignments.length === 0) { %>
            <span class="muted">— no players scheduled</span>
          <% } else { %>
            <form class="inline" method="post" action="/admin/sessions/<%= session.id %>/weeks/<%= r.week.id %>/ball-duty" style="display:flex;align-items:center;gap:4px;">
              <select name="player_id" style="width:auto;min-width:110px;padding:4px 6px;font-size:12px;">
                <% r.assignments.forEach(function(a) { %><option value="<%= a.player_id %>" <%= a.player_id === r.week.ball_duty_player_id ? 'selected' : '' %>><%= a.name %></option><% }) %>
              </select>
              <button class="btn small neutral" type="submit">Set</button>
            </form>
          <% } %>
        </div>
        <% if (!r.week.locked) { %>
          <form method="post" action="/admin/sessions/<%= session.id %>/weeks/<%= r.week.id %>/send-reminders">
            <button class="btn small neutral" type="submit">Send reminders now</button>
          </form>
          <% if (session.admin_report_emails) { %>
            <form method="post" action="/admin/sessions/<%= session.id %>/weeks/<%= r.week.id %>/send-admin-report">
              <button class="btn small neutral" type="submit">Send status report now</button>
            </form>
          <% } %>
        <% } else { %>
          <span class="muted">completed</span>
        <% } %>
      </div>
    </div>

    <% if (r.blackedOutNames.length) { %>
      <div class="muted" style="margin-top:6px;font-size:12px;">Blacked out this week: <%= r.blackedOutNames.join(', ') %></div>
    <% } %>

    <div style="margin-top:8px;">
      <% if (r.assignments.length === 0) { %>
        <p class="muted">No players scheduled this week — use Add a player below once the roster's sorted out.</p>
      <% } %>
      <% r.assignments.forEach(function(a) { %>
        <div class="player-row">
          <span class="pname"><strong><%= a.name %></strong> <span class="muted">(<% if (multiCourt) { %>Court <%= a.court %> · <% } %>Team <%= a.team %>)</span><% if (a.is_sub) { %> <span class="muted">sub</span><% } %></span>
          <% if (a.doubleBooked && (a.status === 'scheduled' || a.status === 'confirmed')) { %>
            <span class="badge double_booked">double booked</span>
            <span class="muted" style="font-size:11px;">also in <a href="/admin/sessions/<%= a.doubleBooked.id %>"><%= a.doubleBooked.name %></a></span>
          <% } else if (a.status === 'scheduled' && a.reminded) { %>
            <span class="badge reminded" title="Reminder email sent, no response yet — status is still 'scheduled' underneath.">email sent - unconfirmed<%= a.followedUp ? ' (×2)' : '' %></span>
          <% } else { %>
            <span class="badge <%= a.status %>"><%= a.status.replace('_',' ') %></span>
          <% } %>
          <% if (!r.week.locked) { %>
            <form class="inline" method="post" action="/admin/sessions/<%= session.id %>/weeks/<%= r.week.id %>/reassign">
              <input type="hidden" name="assignment_id" value="<%= a.id %>">
              <select name="new_player_id" onchange="this.nextElementSibling.style.display = this.value === 'one_time_sub' ? 'inline-block' : 'none';">
                <% roster.forEach(function(p) { %><option value="<%= p.id %>" <%= p.id === a.player_id ? 'selected' : '' %>><%= p.name %></option><% }) %>
                <option value="needs_sub">— Needs a sub —</option>
                <option value="one_time_sub">— One-time sub (not on roster) —</option>
              </select>
              <input type="text" name="one_time_sub_name" placeholder="Sub's name" style="display:none;width:120px;">
              <button class="btn small neutral" type="submit">Reassign</button>
            </form>
            <form class="inline" method="post" action="/admin/sessions/<%= session.id %>/weeks/<%= r.week.id %>/resend/<%= a.id %>">
              <button class="btn small neutral" type="submit">Resend link</button>
            </form>
            <form class="inline" method="post" action="/admin/sessions/<%= session.id %>/weeks/<%= r.week.id %>/mark-confirmed/<%= a.id %>">
              <button class="btn small neutral" type="submit">Mark confirmed</button>
            </form>
          <% } %>
        </div>
      <% }) %>
      <% if (!r.week.locked && r.assignments.length < session.players_per_week) { %>
        <%
          var assignedIds = r.assignments.map(function (a) { return a.player_id; });
          var addable = roster.filter(function (p) { return assignedIds.indexOf(p.id) === -1; });
        %>
        <% if (addable.length > 0) { %>
          <form class="inline" method="post" action="/admin/sessions/<%= session.id %>/weeks/<%= r.week.id %>/add-player" style="margin-top:8px;">
            <select name="player_id">
              <option value="">Add a player…</option>
              <% addable.forEach(function (p) { %>
                <option value="<%= p.id %>"><%= p.name %><%= r.blackedOutNames.indexOf(p.name) !== -1 ? ' (blackout)' : '' %></option>
              <% }) %>
            </select>
            <button class="btn small neutral" type="submit">Add to this week</button>
          </form>
          <p class="muted" style="margin-top:4px;font-size:12px;">Adds them as a manual/sub slot for this week only — doesn't change their season target. Anyone flagged "(blackout)" marked that date unavailable; adding them anyway is an admin override, same as Reassign.</p>
        <% } %>
      <% } %>
    </div>
  </div>
<% }) %>
<%- include('../partials/footer') %>
