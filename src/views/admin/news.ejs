<%- include('../partials/admin_header', {title, flashMsg}) %>
<h1>News</h1>
<p class="muted">Posts show on the public <a href="/news">News</a> page. Tick <strong>Show a banner</strong> on a post to put a strip across the top of every player-facing page linking to it — handy for a new feature, a happy hour, or a rain-out. If more than one post has a live banner, the pinned (then newest) one wins. Players can dismiss a banner; it comes back for them if you edit that post.</p>
<div class="actions" style="margin-top:12px;"><a class="btn green" href="/admin/news/new">+ New post</a></div>

<% if (posts.length === 0) { %>
  <p class="muted" style="margin-top:24px;">No posts yet.</p>
<% } else { %>
<div class="table-scroll">
<table class="compact">
  <thead><tr><th>Title</th><th>Status</th><th>Banner</th><th>Date</th><th></th></tr></thead>
  <tbody>
  <% posts.forEach(function (p) { %>
    <tr>
      <td><a href="/admin/news/<%= p.id %>/edit"><%= p.title %></a><% if (p.pinned) { %> 📌<% } %></td>
      <td><% if (p.published) { %><span class="badge confirmed">Published</span><% } else { %><span class="badge scheduled">Draft</span><% } %></td>
      <td>
        <% if (p.bannerShowing) { %><span class="badge confirmed">Showing now</span>
        <% } else if (p.bannerLive) { %><span class="badge scheduled">On (another post wins)</span>
        <% } else if (p.show_banner && !p.published) { %><span class="badge scheduled">On once published</span>
        <% } else if (p.show_banner) { %><span class="badge scheduled">Ended <%= p.banner_until %></span>
        <% } else { %><span class="muted">—</span><% } %>
        <% if (p.show_banner && p.banner_until && (p.bannerLive || !p.published)) { %><div class="muted">until <%= fmtDate(p.banner_until) %></div><% } %>
      </td>
      <td class="muted"><%= p.date ? fmtDate(p.date) : '' %></td>
      <td>
        <div class="row-actions">
          <a class="btn small neutral" href="/admin/news/<%= p.id %>/edit">Edit</a>
          <% if (p.published) { %><a class="btn small neutral" href="/news/<%= p.id %>" target="_blank">View</a><% } %>
          <form method="post" action="/admin/news/<%= p.id %>/delete" class="inline" onsubmit="return confirm('Delete this post and its uploaded images? This can\'t be undone.');">
            <button class="btn small red" type="submit">Delete</button>
          </form>
        </div>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% } %>
<%- include('../partials/footer') %>
