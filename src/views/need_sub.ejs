<%- include('partials/header', {title}) %>
<div class="card">
  <h1>Need a sub?</h1>
  <p class="notice" style="font-size:16px;">Requesting a sub for <strong><%= assignment.name %></strong> — <strong><%= fmtDate(week.match_date) %></strong> at <%= fmtTime(week.match_time) %>.</p>
  <p class="muted">Not you? <a href="/request-sub">Go pick your own name instead</a>.</p>
  <p class="flag">Are you sure? This will immediately email the other players not already scheduled that week, asking if they can cover for <%= assignment.name %>.</p>
  <form method="post" action="/need-sub/<%= token %>">
    <div class="actions">
      <button class="btn red" type="submit">Yes, request a sub</button>
      <a class="btn neutral" href="/schedule">Cancel</a>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
